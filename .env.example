# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored so your secrets never get committed.

# Your full Gmail address (the account that SENDS the mail).
GMAIL_USER=you@example.com

# A 16-character Google "App Password" — NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Where contact messages should be delivered (defaults to GMAIL_USER).
CONTACT_TO=you@example.com

# Port the local server listens on.
PORT=8000

# Set to true to log messages instead of sending them (handy for testing).
MAIL_DRY_RUN=true

# Number of reverse proxies in front of the app (most hosts use 1).
# Required so rate limiting sees the real visitor IP.
TRUST_PROXY=1

# Set to "production" when deployed. The server refuses to start if mail
# credentials are missing in production.
NODE_ENV=development
